# ============================================================================
# API НАСТРОЙКИ КИНОПОИСК
# ============================================================================

# Базовый URL API (v1.4)
API_URL=https://api.kinopoisk.dev/v1.4

# Ваш API ключ (получить на https://api.kinopoisk.dev)
KINOPOISK_API_KEY=your_api_key_here

# Таймауты для API запросов (секунды)
API_TIMEOUT=30
API_CONNECT_TIMEOUT=10
API_READ_TIMEOUT=30

# Повторные попытки
API_MAX_RETRIES=3
API_RETRY_DELAY=2

# ============================================================================
# UI НАСТРОЙКИ
# ============================================================================

# Базовый URL сайта Кинопоиск
BASE_URL=https://www.kinopoisk.ru

# Настройки WebDriver (chrome, firefox, edge)
BROWSER=chrome

# Таймауты WebDriver (секунды)
DRIVER_TIMEOUT=30
DRIVER_IMPLICIT_WAIT=5
DRIVER_PAGE_LOAD_TIMEOUT=60

# Настройки ожиданий
WAIT_TIMEOUT=20
POLL_FREQUENCY=0.5

# Настройки окна браузера
WINDOW_WIDTH=1920
WINDOW_HEIGHT=1080
HEADLESS=false

# ============================================================================
# НАСТРОЙКИ ТЕСТОВ
# ============================================================================

# Время ожидания для капчи (секунды)
CAPTCHA_WAIT_TIME=20

# Паузы между действиями (секунды)
ACTION_DELAY=0.5
SHORT_DELAY=1.0
LONG_DELAY=3.0

# ============================================================================
# НАСТРОЙКИ ЛОГИРОВАНИЯ
# ============================================================================

LOG_LEVEL=INFO